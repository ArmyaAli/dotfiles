{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "id": "mushroom.bar",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Toronto",
              "zone": "America/Toronto"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "centerBegin": [],
      "centerEnd": [],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "mushroom.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "device": "",
          "id": "io.github.kristoferlund.webcam"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": []
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "mushroom.notifications",
    "mushroom.dock"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.dock"
  ],
  "dock": {
    "autohide": false,
    "pinned": [
      "chromium",
      "org.wezfurlong.wezterm",
      "org.gnome.Nautilus",
      "obsidian",
      "signal",
      "Discord",
      "com.obsproject.Studio",
      "org.kde.kdenlive",
      "mpv",
      "com.moonlight_stream.Moonlight"
    ],
    "position": "bottom"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "mushroom.dock"
    },
    {
      "id": "mushroom.dashboard"
    },
    {
      "id": "mushroom.notifications"
    }
  ],
  "version": 1
}
