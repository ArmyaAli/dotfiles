# Vagrant networking defaults for LAN static IP usage.
# Copy this file to .env and adjust values for your environment.

VAGRANT_NETWORK_MODE=public_static
VAGRANT_BRIDGE_INTERFACE=Realtek Gaming 2.5GbE Family Controller
VAGRANT_PUBLIC_IP_DEVBOX=192.168.2.150
VAGRANT_PUBLIC_NETMASK=255.255.255.0

# Optional per-machine overrides:
# VAGRANT_PUBLIC_IP_KALI=192.168.2.151
# VAGRANT_PUBLIC_IP_TAILS=192.168.2.152

# Optional SSH overrides:
# VAGRANT_SSH_PORT=2222
# VAGRANT_SSH_PORT_KALI=2223
# VAGRANT_SSH_PORT_TAILS=2224
